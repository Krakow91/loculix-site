Options -MultiViews
RewriteEngine On

# 301: *.html URLs → clean URL (kein .html in der Adressleiste)
RewriteCond %{THE_REQUEST} \s/+mia/(.+?)\.html[\s?] [NC]
RewriteRule ^ /mia/%1 [R=301,NE,L]

# Intern: clean URL → *.html Datei
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+?)/?$ $1.html [L]
